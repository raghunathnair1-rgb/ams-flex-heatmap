# Azure AI Foundry (Azure OpenAI-compatible) model access.
# Get these from your Azure AI Foundry project -> Deployments.
AZURE_AI_FOUNDRY_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_AI_FOUNDRY_API_KEY=<your-key>
AZURE_AI_FOUNDRY_MODEL=<your-deployment-name>
AZURE_AI_FOUNDRY_API_VERSION=2024-10-21

# Real flight price data (optional). Amadeus for Developers Self-Service was
# permanently shut down in July 2026 (portal decommissioned, keys disabled),
# so it's no longer a usable provider — api/amadeus_client.py is kept as
# reference wiring for a future real-data provider (e.g. Kiwi.com Tequila,
# Duffel). Leave these unset and the app runs on clearly-labeled mock data.
AMADEUS_CLIENT_ID=<your-client-id>
AMADEUS_CLIENT_SECRET=<your-client-secret>
AMADEUS_ENV=test

# Used by the frontend during local dev (Vite) to reach the FastAPI backend.
VITE_API_BASE_URL=http://localhost:8000
