# Azure AI Foundry (Azure OpenAI-compatible) model access.
# Get these from your Azure AI Foundry project -> Deployments.
AZURE_AI_FOUNDRY_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_AI_FOUNDRY_API_KEY=<your-key>
AZURE_AI_FOUNDRY_MODEL=<your-deployment-name>
AZURE_AI_FOUNDRY_API_VERSION=2024-10-21

# Used by the frontend during local dev (Vite) to reach the FastAPI backend.
VITE_API_BASE_URL=http://localhost:8000
